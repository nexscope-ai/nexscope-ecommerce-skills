{
  "name": "ecommerce.product-video-generator-api",
  "version": "1.0.0",
  "description": "Generate video asynchronously from one image or controlled first and last frames.",
  "entrypoint": null,
  "operationCount": 1,
  "operations": [
    {
      "id": "create_video_task",
      "summary": "Create an asynchronous product-video generation task.",
      "method": "POST",
      "gatewayPath": "/api/v1/tools/research/aigc/videoGenAsync",
      "upstreamPath": "scripts/aigc_videogen.py",
      "mutation": false,
      "callable": true,
      "executionMode": "gateway-script",
      "requiredInputs": [
        "imageUrl",
        "videoType",
        "videoTime"
      ],
      "optionalInputs": [
        "prompt",
        "promptOptimizer",
        "isPro",
        "voice",
        "lastFrameImageUrl",
        "aspectRatio",
        "resolution",
        "memberId"
      ]
    },
    {
      "id": "query_video_task",
      "summary": "Query a product-video generation task by taskId.",
      "method": "POST",
      "gatewayPath": "/api/v1/tools/research/aigc/taskQuery",
      "upstreamPath": "scripts/aigc_videogen.py",
      "mutation": false,
      "callable": true,
      "executionMode": "gateway-script",
      "requiredInputs": [
        "taskId"
      ],
      "optionalInputs": [
        "memberId"
      ]
    }
  ]
}
